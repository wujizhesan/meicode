{
  "name": "@wujizhesan/meicode",
  "version": "0.1.6",
  "description": "MeiCode — 终端命令行 AI 助手",
  "type": "module",
  "bin": {
    "meicode": "bin/meicode.mjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "config.example.yaml",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "node --import tsx src/cli.tsx",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "pack:check": "npm pack --dry-run",
    "package:smoke": "node scripts/package-smoke.mjs",
    "metrics": "node scripts/metrics.mjs",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm test",
    "test": "npm run typecheck && node scripts/test.mjs",
    "test:fast": "npm run typecheck && node scripts/test.mjs --tier fast",
    "test:serial": "npm run typecheck && node scripts/test.mjs --workers 1",
    "clean:fixtures": "node scripts/clean-fixtures.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "eventsource-parser": "^3.1.0",
    "ink": "^7.1.1",
    "minimatch": "^10.2.6",
    "pixelmatch": "^7.2.0",
    "playwright-core": "^1.62.1",
    "pngjs": "^7.0.0",
    "react": "^19.2.8",
    "typescript5": "npm:typescript@^5.9.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.2.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.18",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wujizhesan/meicode-private.git"
  },
  "homepage": "https://www.npmjs.com/package/@wujizhesan/meicode",
  "bugs": {
    "url": "https://github.com/wujizhesan/meicode-private/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "multi-agent",
    "mcp",
    "a2a"
  ],
  "author": "wujizhesan"
}
